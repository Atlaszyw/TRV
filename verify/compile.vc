-Mdir build

--MMD
--cc
--exe
--trace
--clk clk_i
--build
--build-jobs 20

-prefix riscvv

--timescale 1ns/1ps
-DSIM

-I../design/src/inc

-y ../design/src/core
-y ../design/src/intf
-y ../design/src/debug
-y ../design/src/perips
-y ../design/src/utils

-top riscvv_soc_top

../design/src/pkg/riscvv_pkg.sv
../design/src/soc/riscvv_soc_top.sv
main.cc
