{
    "clangd.arguments": [
        "--all-scopes-completion",
        "--background-index=true",
        "--clang-tidy",
        "--compile-commands-dir=.vscode",
        "--completion-style=detailed",
        "--fallback-style=llvm",
        "--header-insertion=iwyu",
        "--pch-storage=memory",
        "--query-driver=/home/main/Tools/riscv_llvm/bin/clang",
        "-j=16",
        "-log=info"
    ],
    "clangd.fallbackFlags": [
        "-I/home/main/Projects/tinyriscv/tests/example/include",
        "-I/home/main/Projects/tinyriscv/boot/inc"
    ],
    "verilog.lint.slang.includes": [
        "design/src/inc"
    ],
    "verilog.lint.slang.args": "-y design/src/..."
}
